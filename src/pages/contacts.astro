---
import Layout from '../layouts/Layout.astro';
import ContactsCard from '../components/ContactsCard.astro';

const siteOrigin = 'https://simoneferretti.dev';
const pageUrl = `${siteOrigin}/contacts/`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${pageUrl}#contactpage`,
	url: pageUrl,
	name: 'Contact Simone Ferretti',
	description:
		'Get in touch with Simone Ferretti, Product Engineer. Find me on GitHub, LinkedIn, or by email.',
	mainEntity: {
		'@type': 'Person',
		'@id': `${siteOrigin}/#person`,
	},
};
---

<Layout
	title="Contact | Simone Ferretti"
	description="Get in touch with Simone Ferretti, Product Engineer. Find me on GitHub, LinkedIn, or by email. Open to interesting product and tooling projects."
	jsonLd={jsonLd}
>
	<main id="main-content" class="page-main contact-page">
		<header>
			<p class="eyebrow">03 / Get in touch</p><h1>
				Let's build<br />something real.
			</h1>
		</header>
		<section aria-label="Contact information">
			<p class="contact-intro">
				Open to interesting product and tooling projects.
			</p><ContactsCard />
		</section>
	</main>
</Layout>
<style>
	.contact-page {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12%;
		min-height: 65vh;
	}
	h1 {
		margin-top: 32px;
		font-size: clamp(30px, 4vw, 48px);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1.15;
	}
	section {
		padding-top: 150px;
	}
	.contact-intro {
		font-size: 13px;
		color: var(--color-text-secondary);
		margin-bottom: 24px;
	}
	@media (max-width: 640px) {
		.contact-page {
			display: block;
		}
		section {
			padding-top: 64px;
		}
	}
</style>
