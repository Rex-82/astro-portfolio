---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/blog';
import { GITHUB_USERNAME } from 'astro:env/client';

const [latestPost, ...recentPosts] = (await getPublishedPosts()).slice(0, 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://simoneferretti.dev/#person',
			name: 'Simone Ferretti',
			url: 'https://simoneferretti.dev',
			jobTitle: 'Product Engineer',
			sameAs: [
				`https://github.com/${GITHUB_USERNAME}`,
				'https://www.linkedin.com/in/simoneferretti',
			],
			knowsAbout: [
				'TypeScript',
				'Next.js',
				'NestJS',
				'PostgreSQL',
				'Docker',
				'GCP',
				'Linux',
			],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://simoneferretti.dev/#website',
			url: 'https://simoneferretti.dev',
			name: 'Simone Ferretti',
			publisher: { '@id': 'https://simoneferretti.dev/#person' },
			inLanguage: 'en',
		},
	],
};
---

<Layout
	title="Simone Ferretti | Product Engineer"
	description="Product Engineer building agentic systems and the infrastructure they need to not fall over. TypeScript, Next.js, NestJS, PostgreSQL."
	jsonLd={jsonLd}
>
	<main id="main-content" class="home page-main">
		<header class="identity">
			<p class="eyebrow">Independent practice / Personal index</p>
			<h1>Simone Ferretti</h1>
			<p class="role">Product Engineer</p>
			<p class="intro">
				I build systems and the infrastructure<br class="desktop-break" /> they need
				to not fall over.
			</p>
		</header>
		<section class="now" aria-labelledby="now-heading">
			<h2 id="now-heading" class="section-label">
				<span>01</span> Now &amp; elsewhere
			</h2>
			<dl>
				<dt>Building</dt><dd>
					A homelab quietly running my life, and a music player built for how I
					listen.
				</dd>
				<dt>Learning</dt><dd>
					Russian, past the awkward phase. Chinese, still in it.
				</dd>
				<dt>Outside</dt><dd>Lifting and via ferrata in the Dolomites.</dd>
			</dl>
		</section>
		{
			latestPost && (
				<section class="writing" aria-labelledby="writing-heading">
					<h2 id="writing-heading" class="section-label">
						<span>02</span> Selected writing
					</h2>
					<ul class="writing-list">
						{[latestPost, ...recentPosts].map((post) => (
							<PostCard
								id={post.id}
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								tags={post.data.tags}
								coverImage={post.data.coverImage}
							/>
						))}
					</ul>
					<a class="archive-link" href="/blog/">
						All writing <span aria-hidden="true">↗</span>
					</a>
				</section>
			)
		}
		<section class="connect" aria-labelledby="connect-heading">
			<h2 id="connect-heading" class="section-label">
				<span>03</span> Find me elsewhere
			</h2>
			<div>
				<a href="https://www.linkedin.com/in/simoneferretti">LinkedIn ↗</a><a
					href="mailto:simoneferretti99@pm.me">Email ↗</a
				><a href={`https://github.com/${GITHUB_USERNAME}`}>GitHub ↗</a>
			</div>
		</section>
		<span class="margin-note" aria-hidden="true"
			>SF — Field notes &amp; ongoing work</span
		>
	</main>
</Layout>
<style>
	.home {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 12%;
		row-gap: 108px;
		position: relative;
	}
	.identity {
		grid-column: 1;
	}
	.identity .eyebrow {
		margin: 0 0 32px;
	}
	h1 {
		margin: 0;
		font-size: clamp(26px, 2.5vw, 36px);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 1.15;
	}
	.role {
		margin: 8px 0 0;
		font-size: 15px;
	}
	.intro {
		font-size: 14px;
		line-height: 1.6;
		margin: 40px 0 0;
		color: var(--color-text-secondary);
	}
	.now {
		grid-column: 1;
		grid-row: 2;
		max-width: 340px;
	}
	dl {
		display: grid;
		grid-template-columns: 65px 1fr;
		gap: 18px 20px;
		margin: 0;
		font-size: 13px;
		line-height: 1.6;
	}
	dt {
		color: var(--color-text-secondary);
		font-size: 11px;
		padding-top: 2px;
	}
	dd {
		margin: 0;
	}
	.writing {
		grid-column: 2;
		grid-row: 1 / 4;
		padding-top: 124px;
	}
	.writing-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 34px;
	}
	.archive-link {
		display: flex;
		justify-content: space-between;
		margin-top: 36px;
		font-size: 12px;
		text-decoration: none;
	}
	.connect {
		grid-column: 1;
	}
	.connect div {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		font-size: 12px;
	}
	.connect a {
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.margin-note {
		position: absolute;
		right: -34px;
		top: 110px;
		writing-mode: vertical-rl;
		font-size: 9px;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary);
	}
	@media (max-width: 760px) {
		.home {
			column-gap: 7%;
		}
		.desktop-break {
			display: none;
		}
	}
	@media (max-width: 640px) {
		.home {
			grid-template-columns: 1fr;
			gap: 72px;
		}
		.writing {
			grid-column: 1;
			grid-row: 2;
			padding: 0;
		}
		.now {
			grid-row: 3;
		}
		.margin-note {
			display: none;
		}
		.intro {
			max-width: 280px;
		}
	}
</style>
