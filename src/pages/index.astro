---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/blog';
import { GITHUB_USERNAME } from 'astro:env/client';

const [latestPost, ...recentPosts] = (await getPublishedPosts()).slice(0, 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://simoneferretti.dev/#person',
			name: 'Simone Ferretti',
			url: 'https://simoneferretti.dev',
			jobTitle: 'Product Engineer',
			sameAs: [
				`https://github.com/${GITHUB_USERNAME}`,
				'https://www.linkedin.com/in/simoneferretti',
			],
			knowsAbout: [
				'TypeScript',
				'Next.js',
				'NestJS',
				'PostgreSQL',
				'Docker',
				'GCP',
				'Linux',
			],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://simoneferretti.dev/#website',
			url: 'https://simoneferretti.dev',
			name: 'Simone Ferretti',
			publisher: { '@id': 'https://simoneferretti.dev/#person' },
			inLanguage: 'en',
		},
	],
};
---

<Layout
	title="Simone Ferretti | Product Engineer"
	description="Product Engineer building agentic systems and the infrastructure they need to not fall over. TypeScript, Next.js, NestJS, PostgreSQL."
	jsonLd={jsonLd}
>
	<main
		class="px-4 pt-14 pb-16 w-[800px] max-w-[calc(100%-2rem)] text-[16px] text-accent leading-[1.6] flex flex-col items-center"
	>
		<header
			class="flex flex-col items-center w-fit tracking-[0.125em] max-[480px]:tracking-normal"
		>
			<PageTitle title="Simone Ferretti" />
			<p
				class="text-[1.5rem] uppercase tracking-[0.125em] self-end -mt-[2.5em] m-0 max-[768px]:text-[1.125rem] max-[400px]:text-[1rem]"
			>
				<span>product engineer</span>
			</p>
		</header>

		<section class="mt-16 w-full" aria-labelledby="now-heading">
			<h2
				id="now-heading"
				class="m-0 text-[0.875rem] uppercase tracking-[0.125em] [color:color-mix(in_srgb,var(--color-accent-light)_70%,transparent)]"
			>
				Now &amp; Elsewhere
			</h2>
			<dl
				class="m-0 mt-5 grid gap-x-6 gap-y-2 min-[480px]:grid-cols-[6.5rem_1fr] min-[480px]:gap-y-4"
			>
				<dt
					class="text-[0.75rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)] min-[480px]:pt-1"
				>
					Building
				</dt>
				<dd
					class="m-0 mb-3 text-[0.9375rem] text-[var(--color-text-primary)] min-[480px]:mb-0"
				>
					A homelab quietly running my life, and a music player built for how I
					listen.
				</dd>
				<dt
					class="text-[0.75rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)] min-[480px]:pt-1"
				>
					Learning
				</dt>
				<dd
					class="m-0 mb-3 text-[0.9375rem] text-[var(--color-text-primary)] min-[480px]:mb-0"
				>
					Russian, past the awkward phase. Chinese, still in it.
				</dd>
				<dt
					class="text-[0.75rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)] min-[480px]:pt-1"
				>
					Outside
				</dt>
				<dd class="m-0 text-[0.9375rem] text-[var(--color-text-primary)]">
					Lifting and via ferrata in the Dolomites.
				</dd>
			</dl>
		</section>

		{
			latestPost && (
				<section
					class="w-full mt-12 flex flex-col gap-3"
					aria-labelledby="writing-heading"
				>
					<h2
						id="writing-heading"
						class="text-[0.875rem] uppercase tracking-[0.125em] m-0 p-0
						       [color:color-mix(in_srgb,var(--color-accent-light)_70%,transparent)]"
					>
						Writing
					</h2>
					<ul class="list-none p-0 m-0">
						<PostCard
							id={latestPost.id}
							title={latestPost.data.title}
							description={latestPost.data.description}
							pubDate={latestPost.data.pubDate}
							tags={latestPost.data.tags}
							coverImage={latestPost.data.coverImage}
						/>
					</ul>
					<ul class="m-0 list-none divide-y divide-[var(--color-border-subtle)] p-0">
						{recentPosts.map((post) => (
							<li>
								<a
									href={`/blog/${post.id}/`}
									class="flex flex-col gap-1 py-3 text-[0.9375rem] text-[var(--color-text-primary)] no-underline transition-colors hover:text-[var(--color-accent-light)] min-[480px]:flex-row min-[480px]:items-baseline min-[480px]:justify-between min-[480px]:gap-6"
								>
									<span>{post.data.title}</span>
									<time
										datetime={post.data.pubDate.toISOString()}
										class="shrink-0 text-[0.6875rem] uppercase tracking-[0.08em] text-[var(--color-text-secondary)]"
									>
										{post.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'short',
											day: 'numeric',
										})}
									</time>
								</a>
							</li>
						))}
					</ul>
					<a
						href="/blog/"
						class="text-[0.75rem] uppercase tracking-[0.1em] text-[var(--color-text-secondary)]
						       no-underline self-start transition-colors duration-300 ease-[var(--ease-out-expo)]
						       hover:text-[var(--color-accent-light)]"
					>
						Read more on the Blog →
					</a>
				</section>
			)
		}

		<section
			class="mt-12 w-full border-t border-[var(--color-border-subtle)] pt-6"
			aria-labelledby="connect-heading"
		>
			<h2
				id="connect-heading"
				class="m-0 text-[0.875rem] uppercase tracking-[0.125em] [color:color-mix(in_srgb,var(--color-accent-light)_70%,transparent)]"
			>
				Connect
			</h2>
			<ul
				class="m-0 mt-3 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-[0.9375rem]"
			>
				<li>
					<a
						href="https://www.linkedin.com/in/simoneferretti"
						class="text-[var(--color-text-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-accent-light)]"
						>LinkedIn</a
					>
				</li>
				<li>
					<a
						href="mailto:simoneferretti99@pm.me"
						class="text-[var(--color-text-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-accent-light)]"
						>Email</a
					>
				</li>
				<li>
					<a
						href={`https://github.com/${GITHUB_USERNAME}`}
						class="text-[var(--color-text-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-accent-light)]"
						>GitHub</a
					>
				</li>
			</ul>
		</section>
	</main>
</Layout>
