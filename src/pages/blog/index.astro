---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import RssSubscribe from '../../components/RssSubscribe.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();

const siteOrigin = 'https://simoneferretti.dev';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	'@id': `${siteOrigin}/blog/#blog`,
	url: `${siteOrigin}/blog/`,
	name: "Simone Ferretti's Blog",
	description:
		'Thoughts on web development, tools, and side projects by Simone Ferretti.',
	inLanguage: 'en',
	author: {
		'@type': 'Person',
		'@id': `${siteOrigin}/#person`,
		name: 'Simone Ferretti',
		url: siteOrigin,
	},
	blogPost: posts.map((p) => ({
		'@type': 'BlogPosting',
		headline: p.data.title,
		url: `${siteOrigin}/blog/${p.id}/`,
		datePublished: p.data.pubDate.toISOString(),
		...(p.data.updatedDate && {
			dateModified: p.data.updatedDate.toISOString(),
		}),
	})),
};
---

<Layout
	title="Blog | Simone Ferretti"
	description="Thoughts on web development, tools, and side projects by Simone Ferretti."
	jsonLd={jsonLd}
>
	<main
		id="main-content"
		class="blog-index page-main text-text-primary leading-[1.6]"
	>
		<div class="relative">
			<PageTitle title="Blog" />
			<div class="absolute top-0 right-0">
				<RssSubscribe />
			</div>
		</div>
		<p
			class="text-[var(--color-text-secondary)] text-left mt-0 mb-10 text-[0.9375rem]"
		>
			Thoughts on web development, tools, and side projects.
		</p>
		{
			posts.length === 0 ? (
				<p class="text-center text-[var(--color-text-secondary)]">
					No posts yet. Check back soon.
				</p>
			) : (
				<ul class="post-index list-none p-0 grid gap-8">
					{posts.map((post, index) => (
						<PostCard
							id={post.id}
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							tags={post.data.tags}
							coverImage={post.data.coverImage}
							animationDelay={index * 0.1}
						/>
					))}
				</ul>
			)
		}
	</main>
</Layout>

<style>
	.blog-index {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		column-gap: 12%;
		align-content: start;
	}
	.blog-index > p {
		grid-column: 1;
		font-size: 14px;
		max-width: 240px;
	}
	.post-index {
		grid-column: 2;
		grid-row: 1 / 4;
		gap: 64px;
		padding-top: 100px;
	}
	@media (max-width: 640px) {
		.blog-index {
			display: block;
		}
		.post-index {
			padding-top: 32px;
			gap: 40px;
		}
	}
</style>
