---
import { ArrowUpRight } from 'lucide-react';
import { GITHUB_USERNAME } from 'astro:env/client';

const socials = [
	{
		name: 'GitHub',
		url: `https://github.com/${GITHUB_USERNAME}`,
	},
	{
		name: 'LinkedIn',
		url: 'https://www.linkedin.com/in/simoneferretti',
	},
	{
		name: 'Email',
		url: 'mailto:simoneferretti99@pm.me',
	},
];
---

<ul class="contact-list">
	{
		socials.map((social, index) => (
			<li>
				<a href={social.url} target="_blank" rel="noopener noreferrer">
					<>
						<span class="eyebrow">0{index + 1}</span>
						<span>{social.name}</span>
						<ArrowUpRight size="1em" strokeWidth={1.5} aria-hidden="true" />
					</>
				</a>
			</li>
		))
	}
</ul>
<style>
	.contact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		width: 100%;
	}
	a {
		display: grid;
		grid-template-columns: 48px 1fr auto;
		gap: 20px;
		padding: 24px 0;
		color: var(--color-text-primary);
		font-size: 18px;
		border-bottom: 1px solid var(--color-border-subtle);
		align-items: center;
	}
</style>
