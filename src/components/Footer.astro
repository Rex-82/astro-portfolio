---
import { ArrowUpRight } from 'lucide-react';
import { copy, pathFor, type Locale } from '../i18n';
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>Simone Ferretti &copy; {year}</span><span
		>{copy[locale].footer.built}</span
	><a href={pathFor(locale, 'hub')}
		>{copy[locale].footer.hub}
		<ArrowUpRight size="1em" strokeWidth={1.5} aria-hidden="true" /></a
	>
</footer>
<style>
	.site-footer {
		width: 100%;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 32px 48px;
		font-size: 10px;
		color: var(--color-text-secondary);
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	@media (max-width: 640px) {
		.site-footer {
			padding: 24px 20px;
			flex-wrap: wrap;
		}
		.site-footer > span:nth-child(2) {
			display: none;
		}
	}
</style>
