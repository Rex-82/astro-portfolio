---
import { copy, type Locale } from '../i18n';
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>Simone Ferretti &copy; {year}</span>
	<span>{copy[locale].footer.built}</span>
	<label class="theme-control">
		<select data-theme-select aria-label={copy[locale].common.theme}>
			<option value="system">{copy[locale].common.system}</option>
			<option value="light">{copy[locale].common.light}</option>
			<option value="dark">{copy[locale].common.dark}</option>
		</select>
	</label>
</footer>
<style>
	.theme-control { display: inline-flex; align-items: center; gap: 8px; }
	select { color: inherit; background: var(--color-bg); border: 0; font: inherit; min-height: 44px; cursor: pointer; }

	.site-footer {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		padding: 32px 48px;
		font-size: 10px;
		color: var(--color-text-secondary);
	}
	@media (max-width: 640px) {
		.site-footer {
			padding: 24px 20px;
			flex-wrap: wrap;
		}
		.site-footer > span:nth-child(2) {
			display: none;
		}
	}
</style>
