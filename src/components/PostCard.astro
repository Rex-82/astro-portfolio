---
import { ArrowUpRight } from 'lucide-react';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { copy, formatDate, postPath, type Locale } from '../i18n';

interface Props {
	id: string;
	title: string;
	description: string;
	pubDate: Date;
	tags: string[];
	coverImage?: ImageMetadata;
	animationDelay?: number;
	locale: Locale;
	postLocale: Locale;
	coverKey: string;
}

const {
	id,
	title,
	description,
	pubDate,
	tags,
	coverImage,
	locale,
	postLocale,
	coverKey,
} = Astro.props;
---

<li class="post-entry">
	<a href={postPath(postLocale, id)}>
		<div class="post-media">
			{
				coverImage ? (
					<Image
						src={coverImage}
						alt=""
						widths={[320, 640]}
						sizes="(max-width: 900px) 120px, 160px"
					/>
				) : (
					<img
						src={`/covers/${coverKey}/`}
						alt=""
						loading="lazy"
						decoding="async"
						width="1200"
						height="630"
					/>
				)
			}
		</div>
		<div class="post-info">
			<time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time
			>
			{
				locale === 'it' && postLocale === 'en' && (
					<span class="post-tags">{copy.it.common.inEnglish}</span>
				)
			}
			<h2 lang={postLocale}>{title}</h2>
			<p lang={postLocale}>{description}</p>
			{
				tags.length > 0 && (
					<span class="post-tags" lang={postLocale}>
						{tags.slice(0, 2).join(' / ')}
					</span>
				)
			}
		</div>
		<ArrowUpRight
			className="post-arrow"
			size={13}
			strokeWidth={1.5}
			aria-hidden="true"
		/>
	</a>
</li>
<style>
	.post-entry {
		list-style: none;
		min-width: 0;
	}
	a {
		display: grid;
		grid-template-columns: minmax(100px, 160px) minmax(0, 1fr);
		gap: 20px;
		position: relative;
		color: inherit;
		text-decoration: none;
	}
	.post-media {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #291b13;
	}
	.post-media :global(img) {
		display: block;
		height: 100%;
		width: 100%;
		object-fit: cover;
	}
	.post-info {
		min-width: 0;
		padding-top: 2px;
		line-height: 1.4;
	}
	time,
	.post-tags {
		font-size: 10px;
		letter-spacing: 0.03em;
		color: var(--color-text-secondary);
	}
	h2 {
		margin: 8px 0;
		font-size: 15px;
		line-height: 1.35;
		letter-spacing: -0.025em;
		font-weight: 500;
	}
	p {
		margin: 0 0 8px;
		color: var(--color-text-secondary);
		font-size: 12px;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-tags {
		display: block;
		font-size: 9px;
	}
	:global(.post-arrow) {
		position: absolute;
		right: 0;
		bottom: 0;
		font-size: 13px;
	}
	a:hover h2 {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (max-width: 900px) {
		a {
			grid-template-columns: 120px 1fr;
			gap: 18px;
		}
	}
	@media (max-width: 900px) {
		p {
			-webkit-line-clamp: 2;
		}
	}
	@media (max-width: 360px) {
		a {
			grid-template-columns: 95px 1fr;
			gap: 14px;
		}
	}
</style>
