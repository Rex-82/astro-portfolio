---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import { type Locale } from '../i18n';

type Variant = 'bio' | 'link' | 'text';

interface Props {
	variant: Variant;
	index?: string;
	title?: string;
	heading?: string;
	body?: string;
	href?: string;
	// eslint-disable-next-line @typescript-eslint/no-explicit-any
	icon?: any;
	items?: string[];
	featured?: boolean;
	external?: boolean;
	spanClass?: string;
	bgSvg?: string;
	iconOnly?: boolean;
	trackEvent?: string;
	locale?: Locale;
}

const {
	variant,
	index,
	title,
	heading,
	body,
	href,
	icon: Icon,
	items,
	featured = false,
	external = false,
	spanClass = '',
	bgSvg,
	iconOnly = false,
	trackEvent,
	locale = 'en',
} = Astro.props;

const linkAttrs = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};

const outerFrame = 'list-none';
const outerHover = 'group';
const innerBase = 'flex h-full flex-col gap-4';
const innerPadding = 'py-6';
const innerPaddingCompact = 'py-6';
const innerHover = '';

const metaLabel =
	'flex items-center gap-2 text-[0.65rem] uppercase tracking-[0.08em] text-[var(--color-text-secondary)] md:text-[0.72rem] md:tracking-[0.14em]';
---

{
	variant === 'bio' && (
		<div class={`${outerFrame} ${spanClass}`}>
			<div
				class={`${innerBase} hub-bio relative min-h-[220px] gap-4 py-6 md:min-h-[280px] md:gap-5`}
			>
				{bgSvg && (
					<div class="hub-thumbnail" aria-hidden="true" set:html={bgSvg} />
				)}
				<span class={`${metaLabel} relative`}>
					<span class="text-[var(--color-text-secondary)]">
						{index ?? '00'}
					</span>
					<span>{locale === 'it' ? 'in breve' : 'intro'}</span>
				</span>
				{heading && (
					<h1 class="hub-name">
						<span class="text-gradient">{heading}</span>
					</h1>
				)}
				<p class="hub-intro">{body}</p>
			</div>
		</div>
	)
}

{
	variant === 'link' && href && (
		<div class={`${outerFrame} ${outerHover} ${spanClass}`}>
			<a
				href={href}
				aria-label={`${title}: ${body}`}
				{...linkAttrs}
				data-rybbit-event={trackEvent}
				data-rybbit-prop-label={trackEvent ? body : undefined}
				data-rybbit-prop-href={trackEvent ? href : undefined}
				class={`link-block ${innerBase} ${innerHover} ${innerPaddingCompact} no-underline [color:inherit] ${featured ? 'md:p-7' : ''}`}
			>
				<div class="flex items-center justify-between">
					<span class={metaLabel}>
						<span class="text-[var(--color-text-secondary)]">
							{index ?? '00'}
						</span>
						<span class={iconOnly ? 'max-md:hidden' : ''}>{title}</span>
					</span>
					<span
						aria-hidden="true"
						class={`inline-flex h-[14px] w-[14px] items-center justify-center text-[var(--color-text-secondary)] ${iconOnly ? 'max-md:hidden' : ''}`}
					>
						{external ? (
							<ArrowUpRight size={14} strokeWidth={2} aria-hidden="true" />
						) : (
							<ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
						)}
					</span>
				</div>
				<div
					class={`mt-auto flex items-end justify-between gap-3 ${iconOnly ? 'max-md:mt-0 max-md:flex-1 max-md:items-center max-md:justify-center' : ''}`}
				>
					<h3
						class={`link-title m-0 min-w-0 truncate leading-[1.1] text-[var(--color-text-primary)] ${iconOnly ? 'max-md:hidden' : ''} ${featured ? 'text-[1.75rem] md:text-[2rem]' : 'text-[1.25rem] md:text-[1.375rem]'}`}
					>
						{body}
					</h3>
					{Icon && (
						<span
							class={`flex shrink-0 items-center justify-center text-[var(--color-text-secondary)] ${iconOnly ? 'max-md:h-8 max-md:w-8' : ''} ${featured ? 'h-8 w-8' : 'h-6 w-6'}`}
						>
							<Icon />
						</span>
					)}
				</div>
			</a>
		</div>
	)
}

{
	variant === 'text' && (
		<div class={`${outerFrame} ${spanClass}`}>
			<div class={`${innerBase} ${innerPadding}`}>
				<span class={metaLabel}>
					<span class="text-[var(--color-text-secondary)]">
						{index ?? '00'}
					</span>
					<span>{title}</span>
				</span>
				<ul class="hub-text-list m-0 flex list-none flex-col gap-2 p-0">
					{items?.map((item) => (
						<li
							class="text-[0.9375rem] leading-[1.5] text-[var(--color-text-secondary)] md:text-[1rem]"
							set:html={item}
						/>
					))}
				</ul>
			</div>
		</div>
	)
}

<style>
	.hub-name {
		margin: 0;
		font-size: clamp(26px, 2.5vw, 36px);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 1.15;
	}
	.hub-intro {
		margin: 20px 0 0;
		max-width: 36ch;
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.hub-bio {
		padding-right: 240px;
	}
	.hub-thumbnail {
		position: absolute;
		right: 0;
		top: 24px;
		width: 180px;
		height: 225px;
		overflow: hidden;
	}
	@media (max-width: 640px) {
		.hub-bio {
			padding-right: 0;
		}
		.hub-thumbnail {
			position: static;
			width: 140px;
			height: 175px;
			order: 1;
			align-self: flex-end;
			margin-top: 24px;
		}
	}

	.hub-thumbnail :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.hub-text-list :global(strong) {
		color: var(--color-text-primary);
		font-weight: 500;
	}
</style>
