---
import PageSelector from './PageSelector';
import { copy, pathFor, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	translations: Partial<Record<Locale, string>>;
}
const { locale, translations } = Astro.props;
const t = copy[locale];

const currentPath = Astro.url.pathname;
const otherLocale = locale === 'en' ? 'it' : 'en';
const otherTranslation = translations[otherLocale];
const localeLabel = locale.toUpperCase();

const links = [
	{ path: pathFor(locale), label: t.nav.home },
	{ path: pathFor(locale, 'blog'), label: t.nav.blog },
	{ path: pathFor(locale, 'contacts'), label: t.nav.contacts },
];
---

<nav
	class="site-nav"
	aria-label={t.nav.main}
	data-page-links={JSON.stringify(links)}
>
	<div class="nav-inner">
		<PageSelector
			client:load
			currentPath={currentPath}
			links={links}
			transition:persist="page-selector"
		/>
		<div class="nav-right">
			<div class="language-switch" aria-label={t.nav.language}>
				{
					otherTranslation ? (
						<a
							href={otherTranslation}
							lang={locale}
							aria-label={`${localeLabel}. ${t.nav.switchLanguage}`}
							title={t.nav.switchLanguage}
						>
							{localeLabel}
						</a>
					) : (
						<span>{localeLabel}</span>
					)
				}
			</div>
			{
				!translations.it && locale === 'en' && (
					<span class="language-note">
						{t.nav.limited}{' '}
						<a href={pathFor('it', 'blog')}>{t.nav.otherIndex}</a>
					</span>
				)
			}
		</div>
		<a class="wordmark" href={pathFor(locale)}
			>SF<span> / Product Engineer</span></a
		>
	</div>
</nav>

<style>
	.site-nav {
		padding: 28px 48px;
	}
	.nav-inner {
		max-width: var(--width-nav);
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.nav-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 3px;
	}
	.site-nav :global(ul a) {
		color: var(--color-text-secondary);
	}
	.site-nav :global(ul a[aria-current='page']) {
		color: var(--color-accent);
	}
	.site-nav :global(ul a[aria-current='page']) {
		font-weight: 500;
	}
	.language-switch {
		display: flex;
		align-items: center;
		font-size: 10px;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary);
		font-weight: 600;
	}
	.language-switch a {
		color: inherit;
	}
	.language-note {
		font-size: 9px;
		color: var(--color-text-secondary);
		max-width: 220px;
		text-align: right;
	}
	.language-note a {
		color: var(--color-accent);
	}
	.wordmark {
		order: -1;
		font-size: 12px;
		color: var(--color-text-primary);
	}
	.wordmark span {
		color: var(--color-text-secondary);
		margin-left: 10px;
	}
	@media (max-width: 640px) {
		.site-nav {
			padding: 20px;
		}
		.nav-inner :global(ul) {
			flex: 0 1 70%;
			min-width: 0;
			margin: 0;
		}
		.nav-inner :global(ul li:not([aria-hidden])) {
			flex: 1 1 0;
			min-width: 0;
			height: 44px;
		}
		.nav-inner :global(ul a) {
			width: 100%;
			padding-inline: 4px;
			white-space: nowrap;
		}
		.nav-right {
			flex: 0 0 auto;
			min-width: 0;
			align-items: flex-end;
		}
		.language-switch a {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 44px;
			min-height: 44px;
		}
		.wordmark span {
			display: none;
		}
		.wordmark {
			flex: 0 0 auto;
			min-width: 0;
			min-height: 44px;
			display: inline-flex;
			align-items: center;
			justify-content: flex-start;
		}
		.language-note {
			max-width: 140px;
		}
	}
</style>
