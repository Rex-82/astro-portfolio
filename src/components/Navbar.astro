---
import PageSelector from './PageSelector';

const currentPath = Astro.url.pathname;

const links = [
	{ path: '/', label: 'Home' },
	{ path: '/blog/', label: 'Blog' },
	{ path: '/contacts/', label: 'Contacts' },
];
---

<nav class="site-nav" aria-label="Main navigation">
	<div class="nav-inner">
		<PageSelector
			client:load
			currentPath={currentPath}
			links={links}
			transition:persist="page-selector"
		/>
		<a class="wordmark" href="/">SF<span> / Product Engineer</span></a>
	</div>
</nav>

<style>
	.site-nav {
		padding: 28px 48px;
	}
	.nav-inner {
		max-width: var(--width-nav);
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.wordmark {
		order: -1;
		font-size: 12px;
		text-decoration: none;
		color: var(--color-text-primary);
	}
	.wordmark span {
		color: var(--color-text-secondary);
		margin-left: 10px;
	}
	@media (max-width: 640px) {
		.site-nav {
			padding: 20px;
		}
		.wordmark span {
			display: none;
		}
	}
</style>
