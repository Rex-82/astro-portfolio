---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowLeft } from 'lucide-react';
import RssSubscribe from '../components/RssSubscribe.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { copy, formatDate, pathFor, postPath, type Locale } from '../i18n';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags: string[];
	id: string;
	coverImage?: ImageMetadata;
	readingTime?: number;
	noindex?: boolean;
	tldr?: string;
	wordCount?: number;
	locale: Locale;
	coverKey: string;
	translations: Partial<Record<Locale, string>>;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	id,
	coverImage,
	readingTime,
	noindex,
	tldr,
	wordCount,
	locale,
	coverKey,
	translations,
} = Astro.props;

const t = copy[locale].blog;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = `${siteOrigin}${postPath(locale, id)}`;
const ogImage = coverImage
	? `${siteOrigin}${coverImage.src}`
	: `${siteOrigin}/api/og?title=${encodeURIComponent(title)}`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${canonicalUrl}#blogposting`,
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		'@id': 'https://simoneferretti.dev/#person',
		name: 'Simone Ferretti',
		url: 'https://simoneferretti.dev',
	},
	publisher: {
		'@type': 'Person',
		'@id': 'https://simoneferretti.dev/#person',
		name: 'Simone Ferretti',
		url: 'https://simoneferretti.dev',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
	isPartOf: {
		'@type': 'Blog',
		'@id': `${siteOrigin}${pathFor(locale, 'blog')}#blog`,
		name: t.name,
		url: `${siteOrigin}${pathFor(locale, 'blog')}`,
	},
	inLanguage: locale,
	image: ogImage,
	url: canonicalUrl,
	keywords: tags.join(', '),
	...(wordCount && { wordCount }),
};

const articleMeta = {
	publishedTime: pubDate.toISOString(),
	...(updatedDate && { modifiedTime: updatedDate.toISOString() }),
	tags,
	author: 'Simone Ferretti',
};

const formattedDate = formatDate(pubDate, locale, 'long');

const formattedUpdatedDate =
	updatedDate && formatDate(updatedDate, locale, 'long');
---

<Layout
	title={`${title} | Simone Ferretti`}
	description={description}
	ogType="article"
	ogDescription={description}
	ogImage={ogImage}
	canonicalUrl={canonicalUrl}
	jsonLd={jsonLd}
	noindex={noindex}
	articleMeta={articleMeta}
	locale={locale}
	translations={translations}
>
	<main id="main-content">
		<ReadingProgress />
		<nav class="mb-6">
			<a
				href={pathFor(locale, 'blog')}
				class="group inline-flex items-center gap-1.5 select-none no-underline
				       text-[var(--color-text-secondary)] text-[0.75rem] uppercase tracking-[0.1em]
				       transition-colors duration-300 ease-[var(--ease-out-expo)]
				       hover:text-[var(--color-accent-light)]"
			>
				<ArrowLeft
					size={14}
					strokeWidth={2}
					aria-hidden="true"
					className="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:-translate-x-[3px]"
				/>
				{t.back}
			</a>
		</nav>
		<article>
			<header class="header--hero">
				<div class="hero-image-wrapper">
					{
						coverImage ? (
							<Image
								src={coverImage}
								alt={t.cover(title)}
								class="cover-image"
								widths={[400, 800, 1200]}
								sizes="(max-width: 800px) 100vw, 800px"
							/>
						) : (
							<img
								src={`/covers/${coverKey}/`}
								alt=""
								loading="lazy"
								decoding="async"
								width="1200"
								height="630"
								class="generated-cover"
							/>
						)
					}
					<div class="hero-content">
						{
							tags.length > 0 && (
								<div class="tags">
									{tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)
						}
						<h1><span class="text-gradient">{title}</span></h1>
						<div class="meta">
							<time datetime={pubDate.toISOString()}>{formattedDate}</time>
							{
								readingTime && (
									<>
										<span aria-hidden="true"> · </span>
										<span>{t.reading(readingTime)}</span>
									</>
								)
							}
							{
								formattedUpdatedDate && (
									<span class="updated">{t.updated(formattedUpdatedDate)}</span>
								)
							}
						</div>
					</div>
				</div>
			</header>
			{
				tldr && (
					<aside class="tldr" aria-label={t.summary}>
						<strong>{locale === 'it' ? 'In breve:' : 'TL;DR:'}</strong> {tldr}
					</aside>
				)
			}
			<div class="prose">
				<slot />
			</div>
			<footer class="post-footer" aria-label={t.footerLabel}>
				<p>
					{t.footer}
				</p>
				<div class="post-footer-actions">
					<RssSubscribe locale={locale} />
					<a href={pathFor(locale, 'blog')}>{t.more}</a>
				</div>
			</footer>
		</article>
	</main>
</Layout>

<style>
	main {
		padding: 64px 0 100px;
		width: 900px;
		max-width: calc(100% - 40px);
		color: var(--color-text-primary);
		line-height: 1.6;
	}

	article {
		padding-bottom: 2rem;
	}
	.header--hero {
		margin: 64px 0;
	}
	.hero-image-wrapper {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 200px;
		gap: 48px;
		align-items: start;
	}
	.hero-image-wrapper :global(picture),
	.cover-image,
	.generated-cover {
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		height: 250px;
		object-fit: cover;
	}
	.hero-image-wrapper :global(picture img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-content {
		grid-column: 1;
		grid-row: 1;
	}
	.hero-content h1 {
		font-size: clamp(28px, 3vw, 38px);
		line-height: 1.15;
		font-weight: 500;
		letter-spacing: -0.04em;
		margin: 24px 0;
	}
	@media (max-width: 640px) {
		main {
			padding-top: 32px;
		}
		.header--hero {
			margin: 24px 0;
		}
		.hero-content h1 {
			margin: 12px 0;
		}

		.hero-image-wrapper {
			grid-template-columns: 1fr;
			gap: 16px;
		}
		.hero-content {
			grid-column: 1;
			grid-row: 1;
		}
		.hero-image-wrapper :global(picture),
		.cover-image,
		.generated-cover {
			grid-column: 1;
			grid-row: 2;
			width: 80px;
			height: 100px;
			justify-self: end;
		}
	}

	/* ===== SHARED META ===== */
	.meta {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.updated {
		margin-left: 0.5rem;
		font-style: italic;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		box-shadow: none;
		background: var(--color-surface-tag);
		padding: 0;
		border-radius: 0;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-accent);
	}

	/* ===== TL;DR BLOCK ===== */
	.tldr {
		max-width: 100%;
		margin: 0 auto 2rem;
		padding: 0.875rem 1.25rem;
		border-left: 3px solid var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 6%, transparent);
		border-radius: 0;
		color: var(--color-text-secondary);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	/* ===== PROSE ===== */
	.prose {
		max-width: 100%;
		margin: 0 auto;
		overflow-wrap: break-word;
	}

	.post-footer {
		max-width: 100%;
		margin: 2.5rem auto 0;
		padding: 1.25rem;
		border-top: 1px solid var(--color-border-subtle);
		color: var(--color-text-secondary);
	}

	.post-footer p {
		margin-bottom: 1rem;
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.post-footer-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.post-footer-actions a {
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition: color 0.3s var(--ease-out-expo);
	}

	.post-footer-actions a:hover {
		color: var(--color-accent-light);
	}

	.prose :global(h2) {
		font-size: 1.375rem;
		font-weight: 600;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		color: var(--color-text-bright);
		letter-spacing: -0.025em;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		font-weight: 600;
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
		color: var(--color-text-bright);
	}

	.prose :global(p) {
		margin-bottom: 1.25rem;
	}

	.prose :global(a) {
		color: var(--color-accent-light);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		transition: color 0.3s var(--ease-out-expo);
	}

	.prose :global(a:hover) {
		color: var(--color-text-bright);
	}

	.prose :global(strong) {
		color: var(--color-text-bright);
	}

	.prose :global(code) {
		background: var(--color-border-subtle);
		padding: 0.125rem 0.375rem;
		border-radius: 4px;
		font-size: 0.875em;
	}

	/* Code blocks with gradient top accent bar */
	.prose :global(pre) {
		position: relative;
		background: var(--color-surface);
		padding: 1.75rem 1.25rem 1.25rem;
		border-radius: 2px;
		overflow-x: auto;
		margin-bottom: 1.5rem;
		border: 1px solid var(--color-surface-tag);
	}

	.prose :global(pre::before) {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(
			to right,
			var(--color-accent),
			var(--color-accent-light),
			transparent
		);
		border-radius: 8px 8px 0 0;
	}

	.prose :global(pre code) {
		background: none;
		padding: 0;
		border-radius: 0;
		font-size: 0.875rem;
	}

	/* Blockquotes with decorative quotation mark */
	.prose :global(blockquote) {
		position: relative;
		border-left: 3px solid
			color-mix(in srgb, var(--color-accent) 50%, transparent);
		padding: 1rem 1.25rem;
		margin-left: 0;
		margin-bottom: 1.5rem;
		color: var(--color-text-muted);
		font-style: italic;
		background: color-mix(in srgb, white 2%, transparent);
		border-radius: 0;
	}

	.prose :global(blockquote::before) {
		content: '\201C';
		position: absolute;
		top: -0.5rem;
		left: 0.75rem;
		font-size: 3rem;
		color: color-mix(in srgb, var(--color-accent) 15%, transparent);
		font-style: normal;
		line-height: 1;
		font-family: Georgia, 'Times New Roman', serif;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.prose :global(li) {
		margin-bottom: 0.375rem;
	}

	.prose :global(li::marker) {
		color: color-mix(in srgb, var(--color-accent-light) 50%, transparent);
	}

	/* Gradient HR matching header separator */
	.prose :global(hr) {
		border: none;
		height: 1px;
		background: linear-gradient(
			to right,
			transparent,
			color-mix(in srgb, var(--color-accent) 30%, transparent),
			transparent
		);
		margin: 2.5rem auto;
		max-width: 200px;
	}

	.prose :global(img) {
		max-width: 100%;
		border-radius: 2px;
		box-shadow: none;
	}
</style>
