---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import faviconSrc from '../../public/assets/favicon/favicon.png';
import faviconSvgSrc from '../../public/assets/favicon/favicon.svg';
import { copy, pathFor, rssPath, type Locale } from '../i18n';

interface Props {
	title: string;
	description: string;
	ogType?: string;
	ogDescription?: string;
	ogImage?: string;
	canonicalUrl?: string;
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
	articleMeta?: {
		publishedTime: string;
		modifiedTime?: string;
		tags?: string[];
		author?: string;
	};
	locale: Locale;
	translations?: Partial<Record<Locale, string>>;
}

const {
	title,
	description,
	ogType = 'website',
	ogDescription,
	ogImage,
	canonicalUrl,
	jsonLd,
	noindex,
	articleMeta,
	locale,
	translations = {
		en: pathFor('en', Astro.url.pathname.replace(/^\/it\//, '')),
		it: pathFor('it', Astro.url.pathname.replace(/^\/it\//, '')),
	},
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const ogImageUrl =
	ogImage ?? `${siteOrigin}/api/og?title=${encodeURIComponent(title)}`;
const resolvedCanonical =
	canonicalUrl ?? new URL(Astro.url.pathname, siteOrigin).href;
const resolvedOgDescription = ogDescription ?? description;
const t = copy[locale];

const appleTouchIcon = await getImage({
	src: faviconSrc,
	width: 180,
	height: 180,
	format: 'png',
});
const faviconSvg = await getImage({ src: faviconSvgSrc, format: 'svg' });
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,follow" />}
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#f2f1ef" />
		<link rel="icon" type="image/svg+xml" href={faviconSvg.src} />
		<meta name="generator" content={Astro.generator} />

		<script is:inline>
			(() => {
				if (window.__portfolioTheme) { window.__portfolioTheme(); return; }
				const media = window.matchMedia('(prefers-color-scheme: dark)');
				let preference = 'system';
				try { preference = localStorage.getItem('portfolio-theme') || 'system'; } catch {}
				if (!['system', 'light', 'dark'].includes(preference)) preference = 'system';
				const apply = (root = document.documentElement, doc = document) => {
					const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
					root.dataset.theme = theme;
					doc.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#111111' : '#f2f1ef');
					doc.querySelectorAll('[data-theme-select]').forEach(select => { select.value = preference; });
				};
				window.__portfolioTheme = () => apply();
				apply();
				media.addEventListener('change', () => apply());
				document.addEventListener('astro:before-swap', event => apply(event.newDocument.documentElement, event.newDocument));
				document.addEventListener('astro:page-load', () => apply());
				document.addEventListener('change', event => {
					if (!event.target.matches?.('[data-theme-select]')) return;
					preference = event.target.value;
					try {
						if (preference === 'system') localStorage.removeItem('portfolio-theme');
						else localStorage.setItem('portfolio-theme', preference);
					} catch {}
					apply();
				});
			})();
		</script>
		<ClientRouter />

		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="manifest" href="/manifest.json" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={t.common.rss}
			href={rssPath(locale)}
		/>

		<title>{title}</title>

		<link rel="canonical" href={resolvedCanonical} />
		{
			Object.entries(translations).map(
				([lang, path]) =>
					path && (
						<link
							rel="alternate"
							hreflang={lang}
							href={new URL(path, siteOrigin).href}
						/>
					),
			)
		}
		{
			translations.en && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={new URL(translations.en, siteOrigin).href}
				/>
			)
		}

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href={faviconSvg.src} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={appleTouchIcon.src} />

		<meta property="og:title" content={title} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:description" content={resolvedOgDescription} />
		<meta property="og:url" content={resolvedCanonical} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={resolvedOgDescription} />
		<meta name="twitter:image" content={ogImageUrl} />

		{
			articleMeta && (
				<>
					<meta
						property="article:published_time"
						content={articleMeta.publishedTime}
					/>
					{articleMeta.modifiedTime && (
						<meta
							property="article:modified_time"
							content={articleMeta.modifiedTime}
						/>
					)}
					{articleMeta.author && (
						<meta property="article:author" content={articleMeta.author} />
					)}
					{articleMeta.tags?.map((tag) => (
						<meta property="article:tag" content={tag} />
					))}
				</>
			)
		}

		{
			jsonLd && (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			)
		}

		<script
			src="https://rybbit.rilae.com/api/script.js"
			data-site-id="b011be291378"
			defer
			async></script>
	</head>
	<body>
		<div id="reading-progress" class="reading-progress" aria-hidden="true">
		</div>
		<a class="skip-link" href="#main-content">{t.common.skip}</a>
		<header>
			<Navbar locale={locale} translations={translations} />
		</header>
		<slot />
		<Footer locale={locale} />

		<script>
			function syncPageSelector() {
				const nav = document.querySelector<HTMLElement>('[data-page-links]');
				const list = nav?.querySelector('ul');
				if (!nav?.dataset.pageLinks || !list) return;
				const links = JSON.parse(nav.dataset.pageLinks) as {
					path: string;
					label: string;
				}[];
				const active = links.findIndex((link) =>
					link.path === '/' || link.path === '/it/'
						? window.location.pathname === link.path
						: window.location.pathname.startsWith(link.path),
				);
				list.querySelectorAll('a').forEach((anchor, index) => {
					const link = links[index];
					if (!link) return;
					anchor.href = link.path;
					anchor.textContent = link.label;
					if (index === active) anchor.setAttribute('aria-current', 'page');
					else anchor.removeAttribute('aria-current');
				});
			}
			const navWindow = window as Window & {
				__pageSelectorSyncReady?: boolean;
			};
			if (!navWindow.__pageSelectorSyncReady) {
				navWindow.__pageSelectorSyncReady = true;
				document.addEventListener('astro:page-load', () =>
					requestAnimationFrame(syncPageSelector),
				);
			}
			requestAnimationFrame(syncPageSelector);

			type ReadingProgressWindow = Window & {
				__readingProgressControllerReady?: boolean;
			};

			const readingProgressWindow = window as ReadingProgressWindow;

			function getReadingProgressBar() {
				return document.getElementById('reading-progress');
			}

			function isReadingProgressPage() {
				return document.querySelector('[data-reading-progress-page]') !== null;
			}

			function updateReadingProgress() {
				const readingProgressBar = getReadingProgressBar();

				if (!(readingProgressBar instanceof HTMLElement)) {
					return;
				}

				if (!isReadingProgressPage()) {
					readingProgressBar.hidden = true;
					readingProgressBar.style.width = '0%';
					return;
				}

				const { scrollTop, scrollHeight, clientHeight } =
					document.documentElement;
				const maxScroll = scrollHeight - clientHeight;
				const progress = maxScroll <= 0 ? 0 : (scrollTop / maxScroll) * 100;

				readingProgressBar.hidden = false;
				readingProgressBar.style.width = `${Math.max(0, Math.min(100, progress))}%`;
			}

			if (!readingProgressWindow.__readingProgressControllerReady) {
				readingProgressWindow.__readingProgressControllerReady = true;
				document.addEventListener('astro:page-load', () => {
					requestAnimationFrame(updateReadingProgress);
				});
				window.addEventListener('scroll', updateReadingProgress, {
					passive: true,
				});
				window.addEventListener('resize', updateReadingProgress);
			}

			requestAnimationFrame(updateReadingProgress);
		</script>
	</body>
</html>

<style is:global>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 2px;
		width: 0%;
		background: var(--color-accent);
		z-index: 20;
		pointer-events: none;
		transition: width 0.15s linear;
	}
</style>
