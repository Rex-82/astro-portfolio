---
import { render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import {
	getReadingStats,
	translationFor,
	publicSlug,
	type Post,
} from '../lib/blog';
import { postPath, type Locale } from '../i18n';
interface Props {
	locale: Locale;
	post: Post;
	posts: Post[];
}
const { locale, post, posts } = Astro.props;
const { Content } = await render(post);
const { readingTime, wordCount } = getReadingStats(post.body ?? '');
const en = translationFor(posts, post, 'en');
const it = translationFor(posts, post, 'it');
const translations = {
	...(en && { en: postPath('en', publicSlug(en)) }),
	...(it && { it: postPath('it', publicSlug(it)) }),
};
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	tags={post.data.tags}
	id={publicSlug(post)}
	locale={locale}
	coverKey={post.data.translationKey}
	translations={translations}
	coverImage={post.data.coverImage}
	readingTime={readingTime}
	wordCount={wordCount}
	noindex={post.data.noindex}
	tldr={post.data.tldr}
>
	<Content />
</BlogPost>
