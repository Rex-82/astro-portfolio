---
import Layout from '../layouts/Layout.astro';
import ContactsCard from '../components/ContactsCard.astro';
import { copy, pathFor, type Locale } from '../i18n';
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale].contacts;

const siteOrigin = 'https://simoneferretti.dev';
const pageUrl = `${siteOrigin}${pathFor(locale, 'contacts')}`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${pageUrl}#contactpage`,
	url: pageUrl,
	inLanguage: locale,
	name: t.name,
	description: t.description,
	mainEntity: {
		'@type': 'Person',
		'@id': `${siteOrigin}/#person`,
	},
};
---

<Layout
	title={t.title}
	description={t.description}
	jsonLd={jsonLd}
	locale={locale}
>
	<main id="main-content" class="page-main contact-page">
		<header>
			<p class="eyebrow">{t.eyebrow}</p><h1>
				{t.heading}
			</h1>
		</header>
		<section aria-label={t.section}>
			<p class="contact-intro">
				{t.intro}
			</p><ContactsCard />
		</section>
	</main>
</Layout>
<style>
	.contact-page {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12%;
		min-height: 65vh;
	}
	h1 {
		margin-top: 32px;
		font-size: clamp(30px, 4vw, 48px);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1.15;
	}
	section {
		padding-top: 150px;
	}
	.contact-intro {
		font-size: 13px;
		color: var(--color-text-secondary);
		margin-bottom: 24px;
	}
	@media (max-width: 640px) {
		.contact-page {
			display: block;
		}
		section {
			padding-top: 64px;
		}
	}
</style>
